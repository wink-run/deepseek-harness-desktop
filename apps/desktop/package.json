{
  "name": "@deepseek-ai/dsh-desktop",
  "description": "Electron shell that boots dsh web on loopback and opens a native window",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wink-run/deepseek-harness-desktop.git",
    "directory": "apps/desktop"
  },
  "type": "module",
  "main": "lib/main.js",
  "bin": {
    "dsh-desktop": "lib/bin.js"
  },
  "files": [
    "lib/*.js"
  ],
  "scripts": {
    "build": "tsc -b && tsdown",
    "prepare-resources": "node ./scripts/prepare-resources.mjs",
    "start": "electron .",
    "pack": "pnpm run build && pnpm run prepare-resources && electron-builder --dir",
    "dist": "pnpm run build && pnpm run prepare-resources && electron-builder"
  },
  "license": "MIT",
  "author": "DeepSeek AI",
  "dependencies": {
    "@deepseek-ai/dsh": "workspace:^"
  },
  "devDependencies": {
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "tsdown": "^0.21.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "build": {
    "appId": "com.deepseek.dsh.desktop",
    "productName": "DeepSeek Harness Desktop",
    "executableName": "DeepSeekHarnessDesktop",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "lib/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".pack/dsh",
        "to": "dsh"
      },
      {
        "from": ".pack/node",
        "to": "node"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "wink-run",
        "repo": "deepseek-harness-desktop"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
